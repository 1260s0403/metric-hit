*.secret
*.secrets
*token*
*credentials*

# Private keys and certificates
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Local databases
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
data/database/*
